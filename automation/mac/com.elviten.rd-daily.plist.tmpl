<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.elviten.rd-daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PY__</string>
    <string>__REPO__/automation/trigger_daily_rd.py</string>
    <string>--cats</string>
    <string>3,7</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUTF8</key>
    <string>1</string>
  </dict>
  <!-- 매일 새벽 4시 0분에 실행 (원하는 시각으로 Hour 수정) -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__REPO__/logs/rd_daily.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/logs/rd_daily.log</string>
</dict>
</plist>
