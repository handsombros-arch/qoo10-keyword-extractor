# ─── 텔레그램 ──────────────────────────────────────
# BotFather (@BotFather) 에서 봇 만들면 발급되는 토큰
TELEGRAM_BOT_TOKEN=
# 본인 계정 chat_id — @userinfobot 또는 봇에 메시지 보낸 후
# https://api.telegram.org/bot<TOKEN>/getUpdates 에서 확인
TELEGRAM_CHAT_ID=

# ─── 백엔드 ────────────────────────────────────────
BACKEND_BASE_URL=http://localhost:8000

# ─── 자동 필터 임계값 ──────────────────────────────
# 경쟁강도(전체 상품수 / 주평 검색량) 이 값 이하만 통과
AUTO_FILTER_COMPETITION_MAX=0.5
# 한국 상품 비율(0~1) 이 값 이상만 통과
AUTO_FILTER_KR_RATIO_MIN=0.3
# 주평 검색량 이 값 이상만 통과
AUTO_FILTER_VOLUME_MIN=100

# ─── 추천 빌드 ─────────────────────────────────────
PRODUCTS_PER_KEYWORD=5
# 마진율(0~1) 이 값 미만은 추천에서 제외 (0.10 = 10%)
MIN_MARGIN_RATE=0.10

# ─── 폴링/타임아웃 ─────────────────────────────────
TASK_POLL_INTERVAL_SEC=10
# 한 단계 태스크 최대 대기 시간 (14400 = 4시간)
TASK_TIMEOUT_SEC=14400
