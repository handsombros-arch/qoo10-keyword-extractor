# Supabase PostgreSQL 연결 URL (DIRECT connection, port 5432)
# 형식: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Supabase 대시보드: Project Settings → Database → Connection string → URI 의 DIRECT_URL 사용
DATABASE_URL=postgresql://postgres.mbwqufmkwmsdpwcddchc:YOUR_DB_PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# 비워두면 로컬 SQLite (backend/data/qoo10.db) 사용

# 네이버 검색 API (https://developers.naver.com/)
# 애플리케이션 등록 후 발급받은 값 입력. 일 25,000건 무료.
# m08_naver.py 가 이 값으로 공식 API 호출.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# === LLM 추론 인프라 ===
# 영역별 모델은 provider:model 형식. 변경 후 backend 재시작 필요.
# 자세한 전환/벤치마크는 backend/app/services/llm/README.md 참고.

# Gemini (클라우드)
# 단일 키 사용 시:
GEMINI_API_KEY=
# 또는 여러 키 풀 (콤마 구분, 무료 티어 한도 N배):
# 호출마다 round-robin + 429 quota 초과 시 자동으로 다음 키 페일오버.
# 비어있으면 GEMINI_API_KEY 단독 사용.
GEMINI_API_KEYS=

# Ollama (로컬, RTX 5080 사용 시 활성화)
OLLAMA_BASE_URL=http://localhost:11434

# 영역별 모델 라우팅 — 기본값은 비용 0 시작을 위해 모두 Gemini 2.5 Flash.
# 로컬 모델로 전환하려면 ollama:<모델> 로 바꿔주세요.
# 예: BRAND_MODEL=ollama:qwen2.5:14b
CATEGORY_MODEL=gemini:gemini-2.5-flash
BRAND_MODEL=gemini:gemini-2.5-flash
SET_COUNT_MODEL=gemini:gemini-2.5-flash
SET_SUGGEST_MODEL=gemini:gemini-2.5-flash
VISION_MODEL=gemini:gemini-2.5-flash

# 큐텐 상품명 jp → ko 번역 (3-1 매칭용 사전작업)
# 추천: ollama:qwen3:14b (가나 잔존 거의 0%, 9.3 GB, 평균 11s).
# qwen2.5:7b 는 카타카나 처리 약점 — 2026-04-28 진단(DIAGNOSIS_KANA_BRAND.md) 기반 변경.
# translation_cache 캐시되므로 첫 호출만 비용 발생.
TRANSLATE_MODEL=ollama:qwen3:14b
# 1차 모델 빈 응답/파싱 실패 시 순차 폴백 (콤마 구분).
# qwen3:14b 가 reasoning 토큰 부족으로 빈 응답 줄 때 qwen2.5:14b 가 받아냄.
TRANSLATE_FALLBACK_MODELS=ollama:qwen2.5:14b,ollama:qwen2.5:7b

# Phase 4-B — 큐텐 등록용 콘텐츠 (title_jp/tags/option_name/marketing_points) LLM 생성
# qwen3:14b 가 일본어/한국어 전환 정확. reasoning 토큰 포함이라 max_tokens=2048.
QOO10_CONTENT_MODEL=ollama:qwen3:14b

# Phase 1-D — 브랜드 키워드 확장 (명세 3.3#1~3)
# 큐텐 상위 N개 상품명에서 specific 키워드 추출 (예: 「アヌア」 → 「anua pdrn」)
BRAND_EXPAND_MODEL=ollama:qwen3:14b

# 큐텐 cover ↔ 한국 cover 1:1 비전 매칭 (3-1)
# 두 이미지 동시 입력 → "같은 상품인가" 0~1 점수
# 비전 지원 모델만 가능 (minicpm-v / qwen2.5-vl / gemini)
# 4/28 시운전: minicpm-v 한국 화장품 false reject 빈번 → qwen2.5-vl 변경 (70% accepted)
IMAGE_MATCH_MODEL=ollama:qwen2.5vl:7b

# (선택) 두 모델 ensemble — 시운전 결과 minicpm-v 단독과 동일하거나 못함 (비용 2배).
# 폐기 권장. 단일 모델 + 사장님 검수 토글이 더 효과적.
# IMAGE_MATCH_ENSEMBLE=ollama:minicpm-v:8b
# IMAGE_MATCH_ENSEMBLE_MODE=avg|max|min  (기본 avg)

# 이미지 accepted 임계값. 결합 룰: text >= TEXT_MATCH_THRESHOLD AND image >= IMAGE_MATCH_THRESHOLD.
IMAGE_MATCH_THRESHOLD=0.7

# 텍스트 매칭 — LLM 호출 없는 순수 토큰 자카드 (services/llm/text_match.py).
# 광고 키워드 도용 (예: 「하파크리스틴」 키워드로 IVE 포토카드 등록) 자동 거부.
# 큐텐 product_name_ko ↔ 한국 product_name 토큰 자카드 + 부분문자열 보너스.
TEXT_MATCH_THRESHOLD=0.3

# 호출 로그 (logs/llm_calls/{date}.jsonl)
LLM_LOG_ENABLED=true
LLM_LOG_DIR=logs/llm_calls

# 자동 필터 카테고리 화이트리스트 (콤마구분, 비우면 전체).
# 우선순위: UserData(/settings) > .env > 전체통과
# 예: AUTO_FILTER_CATEGORIES=03.뷰티&화장품,07.식품,12.서플리먼트&다이어트
AUTO_FILTER_CATEGORIES=

# === Phase 1-D R-3 — 야간 자동화 STEP 5.7~5.95 토글 ===
# daily_workflow.py 가 사용. UserData/임계값 슬라이더와 별도 (단순 ON/OFF).

# is_brand=1 키워드의 큐텐 상위 N 상품명 → specific keyword 추출
ENABLE_BRAND_EXPAND=1
BRAND_EXPAND_TOP_N=10

# expanded_keywords → m08 한국 검색 (확장 keyword_kr 로 후보 풀 보강)
ENABLE_EXPANDED_SEARCH=1
EXPANDED_SEARCH_MAX_RESULTS=30

# 큐텐 ↔ 한국 cover 1:N 매칭 (R-2). accepted/rejected decision 결정
ENABLE_MATCH_IMAGES=1
MATCH_IMAGES_TOP_N=3

# === Brand 자동 추가 임계값 ===
# LLM brand detection 결과 confidence 가 이 값 이상이면 brands 테이블에 자동 INSERT.
# UserData('brand_auto_add_threshold') > .env > 0.9 폴백.
BRAND_AUTO_ADD_THRESHOLD=0.9

# === EasyOCR (Phase 2.5 + M-3) ===
OCR_GPU=1
OCR_LANGS=ko,en

# === 비전 (Gemini 2.5 Flash) 비용 보호 ===
# 일별 USD 한도. 초과 시 vision 호출 차단 + Telegram 1회 알림.
VISION_DAILY_BUDGET_USD=2.0
# Gemini 2.5 Flash 단가 (이미지는 input_tokens 에 포함)
VISION_INPUT_PRICE_PER_1M=0.075
VISION_OUTPUT_PRICE_PER_1M=0.30
# 업로드 전 PIL 리사이즈 최대 한 변 픽셀 (비율 유지)
VISION_MAX_IMAGE_PX=1024

# Telegram 알림 (notify.py 가 사용. 비어있으면 콘솔만)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
