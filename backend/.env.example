# Supabase PostgreSQL 연결 URL (DIRECT connection, port 5432)
# 형식: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Supabase 대시보드: Project Settings → Database → Connection string → URI 의 DIRECT_URL 사용
DATABASE_URL=postgresql://postgres.mbwqufmkwmsdpwcddchc:YOUR_DB_PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# 비워두면 로컬 SQLite (backend/data/qoo10.db) 사용

# 네이버 검색 API (https://developers.naver.com/)
# 애플리케이션 등록 후 발급받은 값 입력. 일 25,000건 무료.
# m08_naver.py 가 이 값으로 공식 API 호출.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
