# Supabase PostgreSQL 연결 URL (DIRECT connection, port 5432)
# 형식: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Supabase 대시보드: Project Settings → Database → Connection string → URI 의 DIRECT_URL 사용
DATABASE_URL=postgresql://postgres.mbwqufmkwmsdpwcddchc:YOUR_DB_PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# 비워두면 로컬 SQLite (backend/data/qoo10.db) 사용

# 네이버 검색 API (https://developers.naver.com/)
# 애플리케이션 등록 후 발급받은 값 입력. 일 25,000건 무료.
# m08_naver.py 가 이 값으로 공식 API 호출.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# === LLM 추론 인프라 ===
# 영역별 모델은 provider:model 형식. 변경 후 backend 재시작 필요.
# 자세한 전환/벤치마크는 backend/app/services/llm/README.md 참고.

# Gemini (클라우드)
# 단일 키 사용 시:
GEMINI_API_KEY=
# 또는 여러 키 풀 (콤마 구분, 무료 티어 한도 N배):
# 호출마다 round-robin + 429 quota 초과 시 자동으로 다음 키 페일오버.
# 비어있으면 GEMINI_API_KEY 단독 사용.
GEMINI_API_KEYS=

# Ollama (로컬, RTX 5080 사용 시 활성화)
OLLAMA_BASE_URL=http://localhost:11434

# 영역별 모델 라우팅 — 기본값은 비용 0 시작을 위해 모두 Gemini 2.5 Flash.
# 로컬 모델로 전환하려면 ollama:<모델> 로 바꿔주세요.
# 예: BRAND_MODEL=ollama:qwen2.5:14b
CATEGORY_MODEL=gemini:gemini-2.5-flash
BRAND_MODEL=gemini:gemini-2.5-flash
SET_COUNT_MODEL=gemini:gemini-2.5-flash
SET_SUGGEST_MODEL=gemini:gemini-2.5-flash
VISION_MODEL=gemini:gemini-2.5-flash

# 큐텐 상품명 jp → ko 번역 (3-1 매칭용 사전작업)
# 추천: 로컬 ollama:qwen2.5:7b — translation_cache 캐시되므로 첫 호출만 비용 발생
TRANSLATE_MODEL=ollama:qwen2.5:7b

# 큐텐 cover ↔ 한국 cover 1:1 비전 매칭 (3-1)
# 두 이미지 동시 입력 → "같은 상품인가" 0~1 점수
# 비전 지원 모델만 가능 (minicpm-v / qwen2.5-vl / gemini)
IMAGE_MATCH_MODEL=ollama:minicpm-v:8b
# accepted 임계값 (이 이상이면 DomesticMatchCandidate.decision='accepted')
IMAGE_MATCH_THRESHOLD=0.7

# 호출 로그 (logs/llm_calls/{date}.jsonl)
LLM_LOG_ENABLED=true
LLM_LOG_DIR=logs/llm_calls

# 자동 필터 카테고리 화이트리스트 (콤마구분, 비우면 전체).
# 우선순위: UserData(/settings) > .env > 전체통과
# 예: AUTO_FILTER_CATEGORIES=03.뷰티&화장품,07.식품,12.서플리먼트&다이어트
AUTO_FILTER_CATEGORIES=

# === 비전 (Gemini 2.5 Flash) 비용 보호 ===
# 일별 USD 한도. 초과 시 vision 호출 차단 + Telegram 1회 알림.
VISION_DAILY_BUDGET_USD=2.0
# Gemini 2.5 Flash 단가 (이미지는 input_tokens 에 포함)
VISION_INPUT_PRICE_PER_1M=0.075
VISION_OUTPUT_PRICE_PER_1M=0.30
# 업로드 전 PIL 리사이즈 최대 한 변 픽셀 (비율 유지)
VISION_MAX_IMAGE_PX=1024

# Telegram 알림 (notify.py 가 사용. 비어있으면 콘솔만)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
