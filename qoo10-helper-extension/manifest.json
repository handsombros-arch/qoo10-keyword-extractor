{
  "manifest_version": 3,
  "name": "Qoo10 Helper",
  "version": "0.2.0",
  "description": "Qoo10 자동화 도우미 — Naver/Coupang 상세 수집 (백엔드 큐 폴링)",

  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],

  "host_permissions": [
    "https://smartstore.naver.com/*",
    "https://brand.naver.com/*",
    "https://shopping.naver.com/*",
    "https://search.shopping.naver.com/*",
    "https://www.coupang.com/*",
    "https://coupang.com/*",
    "https://link.coupang.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Qoo10 Helper"
  }
}
